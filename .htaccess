# =============================================================================
# Association Humanitaire Le Petit Nicolas - Configuration Apache
# =============================================================================

# Encodage UTF-8 pour tous les fichiers (accents français)
AddDefaultCharset UTF-8

# Page d'accueil par défaut
DirectoryIndex index.php index.html

# Désactiver la navigation dans les dossiers
Options -Indexes

# Cache navigateur pour les assets statiques (performance)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Compression GZIP (chargement plus rapide)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
</IfModule>

# Sécurité : bloquer accès aux fichiers sensibles
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|conf)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
